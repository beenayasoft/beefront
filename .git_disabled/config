[core]
	repositoryformatversion = 0
	filemode = false
	bare = false
	logallrefupdates = true
	symlinks = false
	ignorecase = true
[remote "origin"]
	url = https://github.com/beenayasoft/beena.git
	fetch = +refs/heads/*:refs/remotes/origin/*
[branch "main"]
	remote = origin
	merge = refs/heads/main
	vscode-merge-base = origin/main
[branch "integration-elvis"]
	vscode-merge-base = origin/main
[branch "opportunity"]
	vscode-merge-base = origin/main
[branch "integration"]
	remote = origin
	merge = refs/heads/integration-elvis
	vscode-merge-base = origin/integration-elvis
